# ============================================================
# HajjSim -- LLM decision layer configuration
# ============================================================
# Copy this file to ".env" and fill in your own key:
#
#     cp .env.example .env
#
# ".env" is git-ignored. NEVER commit a real key, and never paste one into
# a source file -- the simulation only ever reads it from the environment.
#
# app.py loads ".env" automatically at startup. Anything you export in the
# real environment takes precedence over this file, so a CI or production
# value is never silently replaced by a local dev one.
#
# NOTE: this file (.env.example) is COMMITTED to the repository. Never put a
# real key here -- put it in ".env", which is git-ignored.
# ============================================================

# --- Required -----------------------------------------------------------
# Your API key / access token. This is the ONLY place it should ever live.
LLM_API_KEY=paste-your-key-here

# --- Model selection ----------------------------------------------------
# gemini | openai | anthropic | echo   (echo = offline test, no network, no key)
LLM_PROVIDER=gemini
# Leave blank to use the provider's default model.
LLM_MODEL=
# Only needed for a self-hosted or proxied endpoint (e.g. an OpenAI-compatible
# gateway). Leave blank for the vendor's public API.
LLM_BASE_URL=

# --- Behaviour ----------------------------------------------------------
# Set to 0 to turn the LLM off entirely and run the original rule-based agents.
LLM_ENABLED=1
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=300

# --- Cost / volume control ----------------------------------------------
# How many pilgrims the model actually drives. A full run is ~22 half-day
# ticks, so the whole population costs roughly (pilgrims x 22) decisions.
# 0 = every pilgrim (only do this with a small roster or the echo provider).
# 0 = drive EVERY pilgrim with the model (what you usually want).
LLM_MAX_AGENTS=0
# Hard ceiling on live API calls per simulation tick. 0 = unlimited.
LLM_MAX_CALLS_PER_TICK=0
# How many decisions may be in flight at once. Decisions are made in parallel,
# so a tick costs roughly ONE model latency instead of (agents x latency).
LLM_DECISION_WORKERS=12
# Reuse one answer for near-identical situations (same node, risk band and
# option set). Set to 0 to force a fresh call for every single decision.
LLM_CACHE_ENABLED=1
# Only ask the model when something happens to a pilgrim (ritual window opens,
# hazard appears, risk level changes, separated from group). In between, the
# pilgrim continues its last model plan or follows the rules. 0 = every tick.
LLM_EVENT_TRIGGERED=1

# --- Circuit breaker ----------------------------------------------------
# If the provider fails this many times in a row (bad key, wrong model name,
# outage), stop calling it and serve the rule-based fallback instantly, then
# re-probe once after the cooldown. Without this, a broken key makes every
# tick stall on network timeouts and the run looks frozen. 0 disables it.
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN_SECONDS=60

# --- Rate limiting ------------------------------------------------------
# Provider free tiers are measured in requests per MINUTE, and a single tick
# can ask for more than a whole minute's allowance. When the budget is spent
# the engine serves the rule-based decision instantly instead of collecting a
# 429. Gemini's free flash tier is single digits, so start low. 0 = unlimited.
LLM_MAX_REQUESTS_PER_MINUTE=4
